# Build stage — pure-Go SQLite, CGO не нужен
FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
WORKDIR /app/cmd/orchestrator
RUN CGO_ENABLED=0 go build -o /orchestrator .

# Final stage
FROM alpine:latest
WORKDIR /app
COPY --from=builder /orchestrator ./orchestrator
COPY static ./static
RUN mkdir -p data
EXPOSE 8080
ENTRYPOINT ["./orchestrator"]
