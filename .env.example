# Скопируйте в .env и задайте свои значения. Файл .env не коммитится.

ENV=dev
LOG_LEVEL=info

# Обязательно: случайная строка не короче 16 символов.
JWT_SECRET=replace-with-a-long-random-secret
# Обязательно: общий ключ для выдачи токенов агента.
AGENT_BOOTSTRAP_KEY=replace-with-another-long-random-key

PORT=8080
ORCHESTRATOR_HOST=orchestrator
ORCHESTRATOR_PORT=8080
DB_PATH=data/calculator.db

COMPUTING_POWER=16
AGENT_TOKEN_TTL=24h
STALE_TASK_TIMEOUT=2m
EXPRESSION_TIMEOUT=10m
TASK_POLL_INTERVAL=500ms
REQUEST_TIMEOUT=10s
MAX_EXPRESSION_LEN=256
MAX_TASKS_PER_EXPR=256
MAX_OPERATION_TIME_MS=30000
MAX_RETRIES=5
RETRY_BASE_DELAY=2s

TIME_ADDITION_MS=0
TIME_SUBTRACTION_MS=0
TIME_MULTIPLICATIONS_MS=0
TIME_DIVISIONS_MS=0
